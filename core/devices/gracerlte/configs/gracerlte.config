# HakiOS fragment: the Galaxy Note FE (gracerlte) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="gracerlte"
# What a run adds to the kernel's command line: tools/mkboot.sh's --with words not already here (239) and the kernel's
# "debug=0x8 rd=md0 " (17), measured 11 November 2026. The line then holds 606 of 607: a new argument needs room made.
CONFIG_CMDLINE_RUN=256
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_GUARD is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_MAX98512 is not set
# CONFIG_HAKIOS_EXYNOS_ABOX is not set
# CONFIG_HAKIOS_CS47L93 is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_BCM4361_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_S2MPB02_TORCH is not set
# CONFIG_HAKIOS_EXYNOS_CAMERA is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_EXYNOS_SPI is not set
# CONFIG_HAKIOS_EXYNOS_ACPM is not set
# CONFIG_HAKIOS_EXYNOS_M3 is not set
# CONFIG_HAKIOS_EXYNOS_USB is not set
# CONFIG_HAKIOS_ADRENO is not set
# The Mali-T880 through the Mali driver, the 8890 glue its SoC side (soc/drivers/core/hakios.exynos8890_g3d.c)
CONFIG_HAKIOS_MALI=y
# A surface's caches cleaned for the GPU only when its contents changed, and Mesa's no-purge advice answered in the shim:
# the window server's median frame 14.3 -> 7.3 ms on the gesture script, nothing drawn wrong (runs 20261108T201319, 202435)
CONFIG_MCS=1
CONFIG_CAENV="HMD=1"
# CONFIG_HAKIOS_EXYNOS9810_G3D is not set
# CONFIG_HAKIOS_EXYNOS_DPU is not set
# CONFIG_HAKIOS_S6E3HA8 is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_EXYNOS_KEYS is not set
# The touch screen: an S6SY661 on HSI2C7 (drivers/input/hakios.s6sy761.c, its gracerlte board)
CONFIG_HAKIOS_S6SY761=y
CONFIG_S6SY761=1
CONFIG_S6SY761_BOARD="gracerlte"
# CONFIG_HAKIOS_SSP is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
CONFIG_HAKIOS_BATTERY=y
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_S2MPS18_RTC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_MAX77705 is not set
# CONFIG_HAKIOS_EXYNOS9810_TMU is not set
# CONFIG_HAKIOS_EXYNOS_POWEROFF is not set
CONFIG_HAKIOS_UFS=y
# The MAX77854's MUIC (drivers/power/hakios.max77854.c), on the SoC's HSI2C without a USI
CONFIG_HAKIOS_EXYNOS_HSI2C=y
CONFIG_HAKIOS_MAX77854=y
# The S2MPS16 PMIC (drivers/power/hakios.s2mps16.c): the touch screen's supplies
CONFIG_HAKIOS_S2MPS16=y
# The panel's brightness (devices/gracerlte/drivers/gpu/hakios.s6e3ha5.c): the AOR alone, approved by Ege 2026-11-11
CONFIG_HAKIOS_S6E3HA5=y
# CONFIG_HAKIOS_WIFI is not set
CONFIG_HAKIOS_WIFI_STA=y
# Wi-Fi, stage 1: the 8890's PCIe to the BCM4359 (wifi_pcie=N)
CONFIG_HAKIOS_EXYNOS_PCIE=y
# CONFIG_HAKIOS_EXYNOS9810_PCIE is not set
CONFIG_HAKIOS_BRCMFMAC=y
# Storage: no loader service (no UEFI), the kernel's own driver on the 8890's controller as S-Boot left it, read only
# CONFIG_UFS is not set
CONFIG_UFS_NATIVE=4
CONFIG_UFS_NATIVE_SOC="exynos8890"
CONFIG_UFS_NATIVE_RO=1
CONFIG_UFS_NATIVE_STEP=5
# iOS's system image, written to SYSTEM from TWRP (tools/phone-write.sh IMAGE SYSTEM); /private/var in RAM
CONFIG_SYSTEM_APFS="ufs_SYSTEM"
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# QEMU's devices: no use on a phone
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_VIRTIO_BLK is not set
# iOS laid out on the panel's own 16:9, 414 x 736 points (the iPhone 8 Plus's: the width UIKit's keyboard has; at 450
# the keyboard's .?123 did nothing); MobileGestalt still sees the iPhone X's screen (userland/src/display_native.c)
CONFIG_FB_NATIVEUI=2
# ... drawn at 1035 x 1840, 2.5 pixels a point, and enlarged to the panel's 1440 x 2560 by the display driver's copy:
# half the panel's pixels for the GPU, which was the limit of the heavy frames (fbwidth=828 fbheight=1472 for fewer)
CONFIG_FBWIDTH=1035
CONFIG_FBHEIGHT=1840
# power, volume and Home: ALIVE GPIO pins, only read (drivers/input/hakios.exynos_keys.c)
CONFIG_HAKIOS_EXYNOS_KEYS=y
CONFIG_EXYNOS_KEYS=1
CONFIG_EXYNOS_KEYS_BOARD="gracerlte"
