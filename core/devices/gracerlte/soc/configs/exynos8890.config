# HakiOS fragment: the exynos8890 family -- what is true of the SoC, whatever device it is in.
CONFIG_SOC="exynos8890"
# The kernel on the four M1s, cores 4-7 of the loader's numbering (platform_gracerlte); the A53s stay the loader's
CONFIG_CPUS=4
CONFIG_BOOTCPU=4
# Samsung's EL3 grants CPU_ON and leaves the core off: the PMU powers it (soc/drivers/core/hakios.exynos8890_cpu.c)
CONFIG_HAKIOS_EXYNOS8890_CPU=y
# The USB log (drivers/core/hakios.dwc3.c) and the 8890's half of it (soc/drivers/core/hakios.exynos8890_usb.c): the
# kernel's log on the host's /dev/cu.usbmodem*, every step, from the start (seen on the phone, 8 November 2026)
CONFIG_HAKIOS_USB_GADGET=y
CONFIG_HAKIOS_EXYNOS8890_USB=y
CONFIG_USB_GADGET=5
CONFIG_USB_GADGET_SOC="exynos8890"
CONFIG_HAKIOS_EXYNOS8890_DECON=y
# frames into buffers of their own, flipped at the DECON's refresh, and enlarged by the panel (hakios.exynos8890_decon.c)
CONFIG_FB_DPP=1
# G1 reads the window server's display surfaces, nothing copied; a frame for one the panel still reads is drawn into
# another (eagl.c scan_target)
CONFIG_FB_ZC=1
# the Mali driver's side for this SoC (soc/drivers/core/hakios.exynos8890_g3d.c); the steps run only with mali=N
CONFIG_HAKIOS_EXYNOS8890_G3D=y
CONFIG_MALI_SOC="exynos8890"
CONFIG_MALI=9
# the SoC's temperatures (drivers/power/hakios.exynos_tmu.c, soc/drivers/core/hakios.exynos8890_tmu.c): read, published,
# and the run ended at 110 C (seen on the phone, 9 November 2026: all four blocks run as S-Boot leaves them)
CONFIG_HAKIOS_EXYNOS8890_TMU=y
CONFIG_HAKIOS_EXYNOS8890_PCIE=y
CONFIG_TMU=3
# the M1s' rate moved with the load, the touch screen and the frames, 728 to 2288 MHz within Samsung's limits
# (drivers/power/hakios.exynos_cpufreq.c; its side for this SoC in soc/drivers/core/hakios.exynos8890_cpu.c)
CONFIG_HAKIOS_EXYNOS_CPUFREQ=y
CONFIG_CPUFREQ_GOV=1
