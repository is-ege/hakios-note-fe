# drivers/power/conf: the battery, the processor's clock, temperatures, the PMICs, the guards of a run left alone.
# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

driver BATTERY
	file    bsd/dev/hakios.battery.c
	file    iokit/Kernel/hakios.battery.cpp iokitcpp
	help    the battery: kern.hakios.battery_*, and HakiosBattery, the IOPMPowerSource Darwin reads the charge from
	help    (the state comes from the audio DSP's battery manager, with adsp=1)

driver CPUFREQ
	file    bsd/dev/hakios.cpufreq.c
	help    the clock of the cores the kernel runs on (cpufreq=1), and the memory bus's votes (ddr=)

standard bsd/dev/hakios.thermal_provider.c
	help    the SoC's temperature, whichever phone: the driver that reads the sensors registers (hakios_thermal_register),
	help    and kern.hakios.thermal_* and hakios_thermal_max_mc() read it; THERMAL and EXYNOS_TMU both register

driver THERMAL
	file    bsd/dev/hakios.thermal.c
	help    the SoC's temperature sensors (thermal=1): kern.hakios.thermal_*, and the run handed back to the
	help    loader when the phone gets too hot (thermal_stop=)

driver PMIC
	file    bsd/dev/hakios.pmic.c
	help    the blocks of the power-management chips the SPMI arbiter shows, and the PMIC's clock (pmic=1); read only

driver PMIC_RTC
	file    bsd/dev/hakios.pmic_rtc.c
	default n
	help    the phone's real-time clock read at start-up (rtc_pmic=1): the calendar starts at its time when it is valid
	help    and not behind epoch=; the chip's side a glue (hakios.pmic_rtc.h: S2MPS18_RTC, the Note FE's S2MPS16); read only

driver S2MPS18_RTC
	file    bsd/dev/hakios.s2mps18_rtc.c
	requires EXYNOS_ACPM PMIC_RTC
	default n
	help    the Galaxy S9's real-time clock, the S2MPS18 PMIC's RTC read through ACPM: the chip's side of PMIC_RTC;
	help    read only, nothing written to the PMIC

driver BATTGUARD
	file    bsd/dev/hakios.battguard.c
	help    the run handed back to the loader before the battery is flat (battery_stop=<percent>)

standard bsd/dev/hakios.scfb_battery.c
	help    the phone's battery under AVF, as the Scion app writes it into the shared framebuffer (scfb.addr=)

driver EXYNOS_CPUFREQ
	file    bsd/dev/hakios.exynos_cpufreq.c
	default n
	help    an Exynos's CPU frequency governor (cpufreq_gov=1): the clusters' rates moved with the load, the touch screen
	help    and the display's frames, within Samsung's limits, and lowered when the TMU reads them hot; the SoC's side a
	help    glue (cpufreq_soc=: exynos9810, exynos8890)

driver EXYNOS9810_CPUFREQ
	file    bsd/dev/hakios.exynos9810_cpufreq.c
	requires EXYNOS_CPUFREQ EXYNOS_ACPM
	default n
	help    the Exynos 9810's side of the governor (cpufreq_soc=exynos9810, the default): the Galaxy S9's two clusters, a
	help    rate set through ACPM's DVFS, the device tree's limits for the M3s online

driver MAX77705
	file    bsd/dev/hakios.max77705.c
	requires EXYNOS_HSI2C BATTERY
	help    the Galaxy S9's battery: the fuel gauge and charger of its MAX77705, read (never written) over CMGP's
	help    HSI2C and handed to HakiosBattery, the power source iOS reads (max77705=1; max77705_steps=N, max77705_ipclk=MHz); and its
	help    haptic block, the vibration motor for iOS through /dev/hakios-haptic (max77705_haptic=1)

driver EXYNOS_TMU
	file    bsd/dev/hakios.exynos_tmu.c
	help    an Exynos's temperatures: its TMU (BIG, LITTLE, G3D, ISP), the SoC's side a glue (tmu_soc=: exynos9810,
	help    exynos8890), read with each sensor's fuses (tmu=1), published as kern.hakios.temp.* and the POCO's
	help    kern.hakios.thermal_* (tmu=2), and the run ended or the phone powered off when a zone or the battery is too
	help    hot (tmu=3; tmu_stop=, tmu_batt_stop=, tmu_off=1)

driver EXYNOS9810_TMU
	file    bsd/dev/hakios.exynos9810_tmu.c
	requires EXYNOS_TMU EXYNOS_POWEROFF
	help    the Exynos 9810's side of the TMU driver (tmu_soc=exynos9810, the default): the Galaxy S9's two blocks, the
	help    TMU's clock gate, tmu_enable's start and tmu_off's PS_HOLD

driver EXYNOS_POWEROFF
	file    bsd/dev/hakios.exynos_poweroff.c
	help    the Galaxy S9 powered off: PS_HOLD let go in the Exynos 9810's PMU, for the TMU's tmu_off=1 and for a halt
	help    (halt_off=1: the panel blanked first, DCS display-off and sleep-in through DSIM0; halt_off=2: the APM stopped too)
